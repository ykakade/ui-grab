{
  "name": "vite-plugin-ui-grab",
  "version": "0.1.0",
  "description": "Select elements in your running app, comment on them, batch them, and send them to Claude Code.",
  "type": "module",
  "license": "MIT",
  "author": "Yash Kakade",
  "homepage": "https://github.com/ykakade/ui-grab#readme",
